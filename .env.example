# ========================
# read-receipt-tracker 配置
# ========================
# cp .env.example .env

# 数据库路径
# DATABASE_PATH=receipts.db

# API Key (管理后台认证)
# API_KEY=***

# IP 定位开关 (默认开启)
# ENABLE_GEO=1   # 1=开启(带省市定位) 0=关闭(Lite模式,零外部请求)
# 定位接口: ip-api.com(中文) → ipwho.is(中文) → ipinfo.io(兜底)
# 无需 Key，失败自动降级，绝不阻塞像素响应

# 请求频率限制 (每分钟/每IP)
# RATE_LIMIT_PER_MINUTE=60

# 监听地址/端口
# HOST=0.0.0.0
# PORT=5000
