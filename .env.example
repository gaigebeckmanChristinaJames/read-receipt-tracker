# ==============================
# read-receipt-tracker 配置文件
# ==============================
# 复制为 .env 并修改:
#   cp .env.example .env
#
# 注意: .env 已被 .gitignore 排除，不会提交到仓库

# 数据库文件路径
# DATABASE_PATH=/app/data/receipts.db

# 管理后台 API Key (强烈建议设置)
# 设置后所有管理接口 (/, /message/<id>, /api/delete/*) 需要认证
# 请求时附带 Header: X-API-Key: your_key
# 或 URL 参数: ?api_key=your_key
# API_KEY=change_me_to_a_random_string

# 请求频率限制 (每分钟每 IP 最大请求数，默认 60)
# RATE_LIMIT_PER_MINUTE=60

# 监听地址/端口
# HOST=0.0.0.0
# PORT=5000

# 最大请求体大小 (字节)
# MAX_CONTENT_LENGTH=16777216
