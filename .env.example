# ========================
# read-receipt-tracker 配置
# ========================
# cp .env.example .env

# 数据库路径
# DATABASE_PATH=receipts.db

# API Key (管理后台认证)
# API_KEY=***

# GeoIP 数据库 (可选 IP 定位)
# GEOIP_DB=./data/GeoLite2-City.mmdb

# 请求频率限制 (每分钟/每IP)
# RATE_LIMIT_PER_MINUTE=60

# 监听地址/端口
# HOST=0.0.0.0
# PORT=5000

# 最大请求体 (字节)
# MAX_CONTENT_LENGTH=16777216
